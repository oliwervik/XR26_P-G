            <h2><i class="fas fa-arrows-alt-v"></i> Dependency Inversion Principle</h2>
            <p>High-level modules should depend on abstractions, not low-level modules.</p>
            <pre class="code-example"><code class="language-csharp">// BAD: High-level module depends on concrete implementation
public class WeaponController : MonoBehaviour
{
    private Gun gun;  // Concrete dependency

    void Start()
    {
        gun = GetComponent<Gun>();
    }

    void Fire()
    {
        gun.Shoot();  // Tightly coupled to Gun class
    }
}

// GOOD: Both depend on abstraction
public interface IWeapon
{
    void Fire();
}

public class Gun : MonoBehaviour, IWeapon
{
    public void Fire()
    {
        // Gun-specific implementation
    }
}

public class WeaponController : MonoBehaviour
{
    [SerializeField] private IWeapon weapon;  // Depends on abstraction

    void Fire()
    {
        weapon.Fire();  // Works with any IWeapon
    }
}</code></pre>
