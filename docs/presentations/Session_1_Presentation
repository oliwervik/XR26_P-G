    <div class="slide" id="slide-solid-s">
        <div class="slide-number">5b</div>
        <div class="slide-content">
            <h2><i class="fas fa-cube"></i> Single Responsibility Principle</h2>
            <p>Each class should have one job. In Unity, keep input, game logic, and UI separate.</p>
            <pre class="code-example"><code class="language-csharp">// BAD: All-in-one, tightly coupled
public class GameManager : MonoBehaviour {
    void Update() {
        if (Input.GetKeyDown(KeyCode.Space)) {
            // Handle input
            player.Jump();         // Game logic
            ui.ShowJump();         // UI update
            audio.PlayJumpSound(); // Audio
        }
    }
}
// Problem: GameManager does everything—hard to test, change, or reuse.

// GOOD: Decoupled, single responsibility
// Handles only input
public class PlayerInput : MonoBehaviour {
    public UnityEvent OnJump;
    void Update() {
        if (Input.GetKeyDown(KeyCode.Space)) OnJump?.Invoke();
    }
}
// Handles only player logic
public class Player : MonoBehaviour {
    void OnEnable() {
        input.OnJump.AddListener(Jump);
    }
    void Jump() { /* ... */ }
}
// Handles only UI
public class UIManager : MonoBehaviour {
    void OnEnable() {
        input.OnJump.AddListener(ShowJump);
    }
    void ShowJump() { /* ... */ }
}
// How it works:
// - PlayerInput detects input and fires an event.
// - Player and UIManager subscribe to the event and do their own jobs.
// Result: Each class has one job, and they’re loosely coupled.
</code></pre>
