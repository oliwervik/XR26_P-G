        <div class="slide-content">
            <h2><i class="fas fa-code-branch"></i> Interface Segregation Principle</h2>
            <p>Don't force classes to implement interfaces they don't use. In Unity, use small, focused interfaces for different interactions.</p>
            <pre class="code-example"><code class="language-csharp">public interface IInteractable {
    void OnInteract();
}
public interface IDamageable {
    void TakeDamage(float amount);
}
// Only implement what's needed
public class Button : MonoBehaviour, IInteractable {
    public void OnInteract() { /* ... */ }
}
public class DestructibleObject : MonoBehaviour, IDamageable {
    public void TakeDamage(float amount) { /* ... */ }
}
// XR-specific example
public class VRGrabbable : MonoBehaviour, IInteractable {
    public void OnInteract() { /* Handle VR grab */ }
}</code></pre>
